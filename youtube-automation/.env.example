# Copy to .env and fill in as you get each account. Every value is optional —
# whatever is missing, that step runs in mock mode instead of failing.

# --- Scripting (Claude) ---
ANTHROPIC_API_KEY=

# --- Scripting, free alternative: local Ollama instead of Claude ---
# Set OLLAMA_MODEL to use your own machine instead of the Anthropic API —
# $0, no signup, no key. Install Ollama (ollama.com), run `ollama pull
# llama3.1` once, make sure `ollama serve` is running, then set:
#   OLLAMA_MODEL=llama3.1
# Only used if ANTHROPIC_API_KEY is unset.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# --- AI video generation ---
# From cloud.higgsfield.ai -> API Keys -> Create Key. Shown once at creation.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Which image-to-video endpoint to animate scenes with (Higgsfield's catalog
# is image-to-video, not pure text-to-video — see src/providers/videoGen/higgsfield.ts)
HIGGSFIELD_ENDPOINT=/v1/image2video/dop

# --- Voice/TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- YouTube upload (see scripts/youtube-oauth-setup.ts for how to get these) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Compliance defaults (do not flip lightly - see README) ---
CHANNEL_MADE_FOR_KIDS=true
DEFAULT_PRIVACY_STATUS=private
